# Production environment template for docker-compose deployment.
# Copy to .env.prod, fill in real values, never commit to git.
#
# Used with:
#   docker compose -f docker-compose.yml \
#                  -f deploy/compose/docker-compose.prod.yml \
#                  --env-file deploy/compose/.env.prod up -d

# ---- App secrets ----
# Generate with: openssl rand -base64 48
RM_SECRET_KEY=REPLACE_ME_long_random_secret_for_jwt_signing

# ---- Postgres ----
POSTGRES_USER=rainmaker
POSTGRES_PASSWORD=REPLACE_ME_strong_postgres_password
POSTGRES_DB=rainmaker
RM_DATABASE_URL=postgresql+asyncpg://rainmaker:REPLACE_ME_strong_postgres_password@postgres:5432/rainmaker

# ---- Garage S3 (populated by deploy/compose/init-garage.sh) ----
# Run the init script once after first `docker compose up`:
#   bash scripts/init_garage.sh
# It writes credentials to var/garage-credentials.env; copy them here.
RM_MINIO_ACCESS_KEY=GK...
RM_MINIO_SECRET_KEY=...
RM_MINIO_BUCKET_OTA=rainmaker-ota
RM_FEATURE_S3_REAL=true
# Public host devices reach for OTA downloads (the presigned URL embeds
# this hostname). Must be reachable from the public internet.
RM_MINIO_PUBLIC_ENDPOINT=s3.example.com:443
RM_MINIO_PUBLIC_SECURE=true

# ---- VerneMQ internal backend user (publisher + ingestor) ----
RM_MQTT_INTERNAL_USER=rainmaker-backend
RM_MQTT_INTERNAL_PASSWORD=REPLACE_ME_strong_backend_mqtt_password

# ---- SMTP for confirmation / reset emails ----
RM_SMTP_HOST=smtp.example.com
RM_SMTP_PORT=587
RM_SMTP_USER=apikey
RM_SMTP_PASSWORD=REPLACE_ME_smtp_token
RM_SMTP_STARTTLS=true
RM_EMAIL_FROM=no-reply@example.com

# ---- CORS allowed origins (your mobile app / web admin) ----
RM_CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# ---- PKI ----
# The intermediate CA cert + key are mounted into /etc/rainmaker/pki/
# via the `pki_data` named volume (see README "Bootstrap" section).
RM_PKI_CA_CERT_PATH=/etc/rainmaker/pki/ca-intermediate.pem
RM_PKI_CA_KEY_PATH=/etc/rainmaker/pki/ca-intermediate.key
RM_PKI_CA_ROOT_CERT_PATH=/etc/rainmaker/pki/ca-root.pem
