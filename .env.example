# Local dev defaults (mirrored by docker-compose.yml).
RM_ENV=dev
RM_DEBUG=true
RM_LOG_LEVEL=DEBUG
RM_LOG_JSON=false

RM_SECRET_KEY=dev-secret-key-32-bytes-minimum-pad!

RM_DATABASE_URL=postgresql+asyncpg://rainmaker:rainmaker@localhost:5432/rainmaker

RM_MQTT_BROKER_HOST=localhost
RM_MQTT_BROKER_PORT=8883
RM_MQTT_WS_HOST=localhost
RM_MQTT_WS_PORT=8083

RM_MINIO_ENDPOINT=localhost:3900
RM_MINIO_ACCESS_KEY=GKxxxx_replace_me
RM_MINIO_SECRET_KEY=change_me_long_secret
RM_MINIO_SECURE=false
RM_MINIO_REGION=garage
RM_MINIO_BUCKET_OTA=rainmaker-ota
RM_MINIO_BUCKET_FILES=rainmaker-files

RM_SMTP_HOST=localhost
RM_SMTP_PORT=5025
RM_SMTP_STARTTLS=false

RM_FEATURE_MQTT_ENABLED=true
RM_FEATURE_OAUTH_ENABLED=false
RM_FEATURE_PUSH_ENABLED=false
